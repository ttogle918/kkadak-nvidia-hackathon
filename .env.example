# 호스트 전용. 샌드박스 이미지·빌드 컨텍스트에 넣지 않는다(.dockerignore 가 제외). 이 파일을 .env 로 복사해 채운다(.env 는 gitignore).
# 키 값은 이 파일(.example)에 절대 적지 않는다.

# build.nvidia.com 에서 발급. OpenShell 게이트웨이 provider 등록 때 한 번만 읽힌다:
#   scripts/gateway_setup.sh   (내부: openshell provider create --name nvidia-prod --type nvidia --from-existing)
NVIDIA_API_KEY=

# 기능별로 다른 키를 쓸 때(D5, core/llm). deploy/llm.example.yaml 의 provider 가 api_key_envs 로 이 이름을 가리킨다.
# 변수 이름만 다르면 되고 같은 키를 넣어도 된다. 호스트에서 도는 코드만 이 값을 읽는다(샌드박스 안은 D1).
NVIDIA_API_KEY_A=
NVIDIA_API_KEY_B=

# NGC 카탈로그·NIM 컨테이너를 받을 때만 필요(선택).
NGC_API_KEY=

# core/llm 백엔드 전환(선택). 키는 provider 단위로 그대로 두고 엔드포인트(api | local)만 바꾼다.
# 로컬 모델이 안 뜨면 아래 줄로 API 로 넘어간다. 기능별 덮어쓰기: LLM_BACKEND_<FEATURE> (예 LLM_BACKEND_FEATURE1=local)
LLM_BACKEND=api

# Tavily 검색 키(D12, 구청 행사 보조 수집). 호스트 수집기 전용 — 샌드박스에 넣지 않는다.
TAVILY_SEARCH_KEY=
