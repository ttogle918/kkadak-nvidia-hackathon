# 호스트 전용. 샌드박스 이미지·빌드 컨텍스트에 넣지 않는다(.dockerignore 가 제외). 이 파일을 .env 로 복사해 채운다(.env 는 gitignore).
# 키 값은 이 파일(.example)에 절대 적지 않는다.

# build.nvidia.com 에서 발급. OpenShell 게이트웨이 provider 등록 때 한 번만 읽힌다:
#   scripts/gateway_setup.sh   (내부: openshell provider create --name nvidia-prod --type nvidia --from-existing)
NVIDIA_API_KEY=

# 기능별로 다른 키를 쓸 때(D5, core/llm). deploy/llm.example.yaml 의 provider 가 api_key_envs 로 이 이름을 가리킨다.
# 변수 이름만 다르면 되고 같은 키를 넣어도 된다. 호스트에서 도는 코드만 이 값을 읽는다(샌드박스 안은 D1).
NVIDIA_API_KEY_A=
NVIDIA_API_KEY_B=

# NGC 카탈로그·NIM 컨테이너를 받을 때만 필요(선택).
NGC_API_KEY=

# core/llm 백엔드 전환(선택). 키는 provider 단위로 그대로 두고 엔드포인트(api | local)만 바꾼다.
# 로컬 모델이 안 뜨면 아래 줄로 API 로 넘어간다. 기능별 덮어쓰기: LLM_BACKEND_<FEATURE> (예 LLM_BACKEND_FEATURE1=local)
LLM_BACKEND=api

# Tavily 검색 키(D12, 구청 행사 보조 수집). 호스트 수집기 전용 — 샌드박스에 넣지 않는다.
TAVILY_SEARCH_KEY=

# ---- 중구 행사 카탈로그(호스트 전용 — 샌드박스·이미지·리포에 넣지 않는다) ----
# 서울 열린데이터광장 인증키(https://data.seoul.go.kr). 없으면 sample 키(5행)로 연결만 확인할 수 있다:
#   python -m domains.kcontext.catalog update --source seoul_openapi --sample
SEOUL_OPENAPI_KEY=
# 공공데이터포털(한국관광공사 TourAPI 등) 서비스키. 활용가이드 확인 전이라 아직 코드에서 쓰지 않는다.
DATA_GO_KR_SERVICE_KEY=
# 관리자 화면·API(/api/admin/*) 토큰. 비어 있으면 관리자 API 는 닫혀 있다. 충분히 긴 임의 문자열을 쓴다.
KC_ADMIN_TOKEN=
# (선택) 카탈로그 저장 폴더(기본 var/catalog), 대상 지역 id 쉼표 목록(기본 jung; 각 id = data/regions/<id>.json)
KC_CATALOG_DIR=
KC_TARGET_REGION=jung,jongno,mapo,gangnam

# ---- 공개 모드(D24, 로컬은 모두 비워 둔다) ----
# 1 이면 공개 모드: 세션 필수·요청 제한·관리자/승인/제보 닫힘·API 문서 끔. 비우거나 0 이면 로컬 모드(지금 동작).
KC_PUBLIC_MODE=
# X-Forwarded-For 를 오른쪽에서 몇 번째로 읽을지(1~3). 기본 없음 — 배포 뒤 실측으로 정한다. 비우면 IP 별 제한을 끈다.
KC_TRUSTED_PROXY_HOPS=
# 하루(KST) LLM 단위 상한(기본 300, 메모리 기반 소프트 상한 — 재시작하면 0), 일정 흐름 동시 수(1~8, 기본 2),
# 카탈로그 자식 동시 수(1~8, 기본 2), 세션 수명 초(기본 7200)·최대 수(기본 1000). 범위 밖이면 시작 실패.
KC_LLM_DAILY_UNITS=
KC_STORY_CONCURRENCY=
KC_CATALOG_CONCURRENCY=
KC_SESSION_TTL_S=
KC_SESSION_MAX=
