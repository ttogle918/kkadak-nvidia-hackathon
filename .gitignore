# 비밀 — 키는 호스트 셸 env 와 OpenShell 게이트웨이 provider 에만 둔다
.env
.env.*
!.env.example
*.pem
*.key

# Python / Node
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/

# 샌드박스 빌드 산출물 (DB 덤프 등)
deploy/openshell/build/

# 커밋하지 않는 개인 문서 (팀 정보·크레딧 코드·초안 메모). Brev 인스턴스에는 scp 로 따로 옮긴다
docs/private/

# Windows 다운로드 메타데이터
*:Zone.Identifier

# K-Context 실행 산출물·원자료 (Sprint 2 §0.3)
var/
domains/kcontext/data/raw/*
!domains/kcontext/data/raw/.gitkeep
frontend/k-context/config.local.js
